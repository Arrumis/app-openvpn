# OpenVPN Access Server の基本設定です。

# Tailscaleなどを常用し、OpenVPNを必要時だけ起動する場合は no のままにします。
RESTART_POLICY=no

# 公開ポートです。
# ADMIN_UI_PORT ... 管理者画面
# HTTPS_PORT    ... 利用者画面
# VPN_UDP_PORT  ... VPN 本体
ADMIN_UI_PORT=943
HTTPS_PORT=9443
VPN_UDP_PORT=1194

# 永続化データの保存先です。
HOST_DATA_DIR=./data
OPENVPN_CONFIG_DIR=./data

# LinuxServer イメージ用の実行ユーザーです。
PUID=1000
PGID=1000

# コンテナ内タイムゾーンです。
TZ=Asia/Tokyo

# VPN が使うホスト側インターフェースです。
INTERFACE=eth0

# 管理者パスワードです。
OPENVPN_ADMIN_PASSWORD=change-me
